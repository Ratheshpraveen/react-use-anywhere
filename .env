# JWT Configuration
JWT_SECRET=your_very_secure_and_long_random_secret_key_here
JWT_ISSUER=react-use-anywhere-app
JWT_AUDIENCE=react-use-anywhere-users

# Token Expiration (in minutes or days)
ACCESS_TOKEN_EXPIRATION=15m
REFRESH_TOKEN_EXPIRATION=7d

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/your_database_name

# Redis Configuration for Token Blacklisting
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Environment
NODE_ENV=development

# Security Settings
PASSWORD_SALT_ROUNDS=12

# Optional: Enable/Disable Features
ENABLE_REGISTRATION=true
ENABLE_PASSWORD_RESET=true
